<?xml version="1.0" encoding="UTF-8"?>
<configuration>
 <system.webServer>

  <rewrite>
   <rules>
   
    <rule name="StaticFiles" stopProcessing="true">
        <match url=".*" />
        <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile"/>
        </conditions>
        <action type="None"/>
    </rule>
    <!-- Auth -->
    <rule name="Auth Login" stopProcessing="true">
     <match url="^Auth/Login$" />
     <action type="Rewrite" url="/Pages/Auth/Login.php" />
    </rule>

    <rule name="Auth Register" stopProcessing="true">
     <match url="^Auth/Register$" />
     <action type="Rewrite" url="/Pages/Auth/Register.php" />
    </rule>

    <rule name="Auth Logout" stopProcessing="true">
     <match url="^Auth/Logout$" />
     <action type="Rewrite" url="/Pages/Auth/Logout.php" />
    </rule>

    <rule name="Auth ForgotPassword" stopProcessing="true">
     <match url="^Auth/ForgotPassword$" />
     <action type="Rewrite" url="/Pages/Auth/ForgotPassword.php" />
    </rule>

    <!-- Users -->
    <rule name="Users Profile" stopProcessing="true">
     <match url="^Users/Profile$" />
     <action type="Rewrite" url="/Pages/Users/Profile.php" />
    </rule>

    <rule name="Users Admin" stopProcessing="true">
     <match url="^Users/Admin$" />
     <action type="Rewrite" url="/Pages/Users/Admin.php" />
    </rule>

    <rule name="Users Payment" stopProcessing="true">
     <match url="^Users/Payment$" />
     <action type="Rewrite" url="/Pages/Users/Payment.php" />
    </rule>

    <rule name="Users Gold" stopProcessing="true">
     <match url="^Users/Gold$" />
     <action type="Rewrite" url="/Pages/Users/Gold.php" />
    </rule>

    <rule name="Users History" stopProcessing="true">
     <match url="^Users/History$" />
     <action type="Rewrite" url="/Pages/Users/History.php" />
    </rule>

    <rule name="Users ChangePassword" stopProcessing="true">
     <match url="^Users/ChangePassword$" />
     <action type="Rewrite" url="/Pages/Users/ChangePassword.php" />
    </rule>

    <!-- Others -->
    <rule name="Downloads" stopProcessing="true">
     <match url="^Others/Downloads$" />
     <action type="Rewrite" url="/Pages/Others/Downloads.php" />
    </rule>

    <rule name="Sukien" stopProcessing="true">
     <match url="^Others/Sukien$" />
     <action type="Rewrite" url="/Pages/Others/Sukien.php" />
    </rule>

    <rule name="Tinhnang" stopProcessing="true">
     <match url="^Others/Tinhnang$" />
     <action type="Rewrite" url="/Pages/Others/Tinhnang.php" />
    </rule>

    <rule name="Mocnap" stopProcessing="true">
     <match url="^Others/Mocnap$" />
     <action type="Rewrite" url="/Pages/Others/Mocnap.php" />
    </rule>

    <rule name="Top" stopProcessing="true">
     <match url="^Others/Top$" />
     <action type="Rewrite" url="/Pages/Others/Top.php" />
    </rule>

    <!-- API -->
    <rule name="Api Active" stopProcessing="true">
     <match url="^Api/Active$" />
     <action type="Rewrite" url="/Api/Users/Active.php" />
    </rule>

    <rule name="Api Gold" stopProcessing="true">
     <match url="^Api/Gold$" />
     <action type="Rewrite" url="/Api/Users/Gold.php" />
    </rule>

    <rule name="Api Password" stopProcessing="true">
     <match url="^Api/Password$" />
     <action type="Rewrite" url="/Api/Users/Password.php" />
    </rule>

    <rule name="Api Callback" stopProcessing="true">
     <match url="^Api/Callback$" />
     <action type="Rewrite" url="/Api/Users/Callback.php" />
    </rule>

    <rule name="Api Card" stopProcessing="true">
     <match url="^Api/Card$" />
     <action type="Rewrite" url="/Api/Users/Card.php" />
    </rule>

    <rule name="Api Email" stopProcessing="true">
     <match url="^Api/Email$" />
     <action type="Rewrite" url="/Api/Users/Email.php" />
    </rule>

    <rule name="Api CardHistory" stopProcessing="true">
     <match url="^Api/CardHistory$" />
     <action type="Rewrite" url="/Api/Users/CardHistory.php" />
    </rule>

    <rule name="Api AtmHistory" stopProcessing="true">
     <match url="^Api/AtmHistory$" />
     <action type="Rewrite" url="/Api/Users/AtmHistory.php" />
    </rule>

    <rule name="Bank Cron" stopProcessing="true">
     <match url="^Bank/Cron$" />
     <action type="Rewrite" url="/Api/Bank/Cron.php" />
    </rule>

    <rule name="Bank Login" stopProcessing="true">
     <match url="^Bank/Login$" />
     <action type="Rewrite" url="/Api/Bank/Login.php" />
    </rule>

    <!-- Downloads folder -->
    <rule name="Downloads Folder" stopProcessing="true">
     <match url="^Downloads/(.*)$" />
     <conditions>
      <add input="{REQUEST_URI}" pattern="^/Pages/Downloads/" negate="true" />
     </conditions>
     <action type="Rewrite" url="/Pages/Downloads/{R:1}" />
    </rule>

    <!-- Home -->
    <rule name="Home" stopProcessing="true">
     <match url="^Home$" />
     <action type="Rewrite" url="/Index.php" />
    </rule>

    <!-- Auto .php -->
    <rule name="Auto PHP" stopProcessing="true">
     <match url="^([^/]+)/?$" />
     <conditions>
      <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true"/>
      <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true"/>
     </conditions>
     <action type="Rewrite" url="{R:1}.php"/>
    </rule>

    <!-- fallback -->
    <rule name="Fallback Index" stopProcessing="true">
     <match url=".*" />
     <conditions>
      <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true"/>
     </conditions>
     <action type="Rewrite" url="/Index.php"/>
    </rule>

   </rules>
  </rewrite>

  <!-- 404 -->
  <httpErrors>
   <remove statusCode="404"/>
   <error statusCode="404" path="/Home" responseMode="ExecuteURL"/>
  </httpErrors>

  <!-- disable directory listing -->
  <directoryBrowse enabled="false"/>

  <!-- mime -->
  <staticContent>
   <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive"/>
   <mimeMap fileExtension=".ipa" mimeType="application/octet-stream"/>
  </staticContent>

  <!-- cache control -->
  <httpProtocol>
   <customHeaders>
    <add name="Cache-Control" value="no-cache, no-store, must-revalidate"/>
   </customHeaders>
  </httpProtocol>

 </system.webServer>
</configuration>